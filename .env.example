# Copy this file to .env and fill in real values.
# Never commit the actual .env file (it's already in .gitignore).

APP_ENV=development
SECRET_KEY=

# PostHog Product Analytics (Client Token & Ingestion Host)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=

# Mixpanel Product Analytics
MIXPANEL_PROJECT_TOKEN=

# Client-facing / Next.js compatible aliases
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Google Analytics 4 (Data API) OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/data-sources/google/callback
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=G-KYK82K8M9J
GA4_API_SECRET=

# Razorpay API Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

DATABASE_URL=
