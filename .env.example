# Copy this file to .env and fill in real values.
# Never commit the actual .env file (it's already in .gitignore).

APP_ENV=development
SECRET_KEY=

# PostHog Product Analytics (Client Token & Ingestion Host)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=

# Client-facing / Next.js compatible aliases
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 (Data API) OAuth — leave blank to run in
# demo-only mode. The Data Sources page will show
# "Configuration required" until all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/data-sources/google/callback
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=G-KYK82K8M9J
GA4_API_SECRET=

# Razorpay API Credentials (Test or Live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

DATABASE_URL=
