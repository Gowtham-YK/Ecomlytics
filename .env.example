# Copy this file to .env and fill in real values.
# Never commit the actual .env file (it's already in .gitignore).

APP_ENV=development
SECRET_KEY=

# Google Analytics 4 (Data API) OAuth — leave blank to run in
# demo-only mode. The Data Sources page will show
# "Configuration required" until all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/data-sources/google/callback
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=G-KYK82K8M9J
GA4_API_SECRET=

# Razorpay API Credentials (Test or Live)
# If left blank, the app runs in interactive Razorpay Demo / Pitch mode
# where payments are simulated with high-fidelity Razorpay UI.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Not used yet in this build — reserved for the Postgres-backed
# multi-tenant model described in ROADMAP.md.
DATABASE_URL=

# Product analytics providers (all optional; configure any or all three).
# Mixpanel: Project Settings -> Project Details -> Project Token
MIXPANEL_PROJECT_TOKEN=

# PostHog: Project Settings -> Project API Key / Project Token (usually phc_...)
POSTHOG_PROJECT_TOKEN=
# US Cloud: https://us.i.posthog.com | EU Cloud: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com

# Amplitude: Settings -> Projects -> General -> API Key
AMPLITUDE_API_KEY=
# US: https://api2.amplitude.com/2/httpapi | EU: https://api.eu.amplitude.com/2/httpapi
AMPLITUDE_INGEST_URL=https://api2.amplitude.com/2/httpapi
