# Copy this file to .env and fill in real values.
# Never commit the actual .env file (it's already in .gitignore).

APP_ENV=development
SECRET_KEY=

# Google Analytics 4 (Data API) OAuth — leave blank to run in
# demo-only mode. The Data Sources page will show
# "Configuration required" until all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/data-sources/google/callback
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=G-N4DCRNR7VV
GA4_API_SECRET=

# Razorpay API Credentials (Test or Live)
# If left blank, the app runs in interactive Razorpay Demo / Pitch mode
# where payments are simulated with high-fidelity Razorpay UI.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Not used yet in this build — reserved for the Postgres-backed
# multi-tenant model described in ROADMAP.md.
DATABASE_URL=
